{
  "name": "collabflow-server",
  "version": "1.0.0",
  "description": "Backend API for CollabFlow - Instagram & YouTube Creator Collaboration OS",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0 <21.0.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "ts-node-dev --transpile-only src/db/seed.ts",
    "db:turso": "node scripts/sync-turso.mjs",
    "test": "npm run build && node --test tests/server-api.test.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.12",
    "@types/uuid": "^9.0.8",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^9.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "typescript": "^5.4.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0"
  }
}
