# 🚀 CollabFlow Server Environment Variables
# Copy this file to .env for local dev, or paste values into Render > Environment

# Server Port (Render sets this automatically)
PORT=5000

# Node Environment
NODE_ENV=production

# JWT Signing Secret (generate with: openssl rand -hex 32)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Local SQLite Database Path
DB_PATH=./collabflow.db

# -------------------------------------------------------------
# 🌐 Free Remote Cloud Database (Turso) — prevents data loss on Render restarts
# Sign up free at https://turso.tech → create a database → copy URL & token
# -------------------------------------------------------------
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# -------------------------------------------------------------
# 📱 TWILIO SMS OTP (Real Phone Verification)
# 1. Go to https://console.twilio.com → Account Info panel (top left)
# 2. Copy Account SID (starts with AC...)
# 3. Click "Show" on Auth Token → copy it
# 4. Go to Phone Numbers → Manage → Active Numbers → copy your number (+1...)
# Without these vars, SMS will NOT be sent (server logs OTP to console for local dev only)
# -------------------------------------------------------------
TWILIO_ACCOUNT_SID=AC36b1b0a539beced8ba44a50b519d46bf
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# -------------------------------------------------------------
# 📺 YouTube Data API v3 (Free: 10,000 queries/day)
# 1. Go to https://console.cloud.google.com
# 2. Create a project → Enable "YouTube Data API v3"
# 3. APIs & Services → Credentials → Create API Key
# Without this, zero-key oEmbed fallback runs (views/likes may not populate)
# -------------------------------------------------------------
# YOUTUBE_API_KEY=AIzaSy...

# -------------------------------------------------------------
# 📧 Email Service for OTP & Password Reset (Pick one)
# Option A — Resend (3,000 free emails/month): https://resend.com
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=noreply@yourdomain.com
#
# Option B — Brevo SMTP (300 free emails/day): https://brevo.com
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_brevo_login@email.com
# SMTP_PASS=your_brevo_smtp_key
# SMTP_FROM=noreply@yourdomain.com
# -------------------------------------------------------------
