# 🚀 CollabFlow Server Environment Variables

# Server Port (Render sets this automatically)
PORT=5000

# Node Environment
NODE_ENV=production

# JWT Signing Secret (Recommended: generate with 'openssl rand -hex 32')
JWT_SECRET=collabflow-production-jwt-secret-key-change-in-prod

# Local SQLite Database Path (Used for local development)
DB_PATH=./collabflow.db

# -------------------------------------------------------------
# 🌐 100% Free Remote Cloud Database via Turso (https://turso.tech)
# Recommended for Render free tier so data persists across container restarts:
# -------------------------------------------------------------
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# -------------------------------------------------------------
# 📺 100% Free YouTube Integration (Google Cloud Console)
# 10,000 queries/day free. If omitted, zero-key fallback scraper runs automatically:
# -------------------------------------------------------------
# YOUTUBE_API_KEY=AIzaSy...

# -------------------------------------------------------------
# 📸 Free Instagram Integration
# If omitted, public Open Graph crawler and captioned Meta Reel player run automatically:
# -------------------------------------------------------------
# INSTAGRAM_ACCESS_TOKEN=IG...
