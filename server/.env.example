# Server Port
PORT=5000

# SQLite Local Database (Default: local file in project)
DB_PATH=./collabflow.db

# Optional: Turso Free Cloud Database (https://turso.tech)
# Use these when deploying to Render or Vercel for 100% free persistent cloud database:
# TURSO_DATABASE_URL=libsql://collabflow-yourname.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
